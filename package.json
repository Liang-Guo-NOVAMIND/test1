{
  "name": "test1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "vite",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "tsc && vite build",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "preview": "vite preview",
    "test": "vitest run",
    "test:all": "npm run test -w frontend && npm run test -w backend",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:all": "npm run lint -w frontend && npm run lint -w backend",
    "format": "prettier --write \"**/*.{ts,tsx,js,css,html,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,css,html,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@vitest/coverage-v8": "^3.1.4",
    "eslint": "^9.27.0",
    "globals": "^16.1.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
